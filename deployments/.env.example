# Production settings for deployments/compose.yml. Copy to deployments/.env, which
# is never committed, and fill in every empty value.

# The public host name; point its DNS A record at this machine first.
DOMAIN=

POSTGRES_USER=lanternly
# A long random value: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=lanternly

# Generate each with the commands in the root .env.example. Never reuse the
# development values, and keep a copy of ENCRYPTION_KEY somewhere safe: losing it
# locks everyone with two-factor out of the second step.
JWT_SECRET=
ENCRYPTION_KEY=

# A real mail provider (Postmark, Resend, Mailgun, SES...). Alerts, resets and
# invites all go out through it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lanternly <alerts@your-domain>"

AUTH_RATE_LIMIT_PER_MINUTE=10
