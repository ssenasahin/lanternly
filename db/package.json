{
  "name": "@lanternly/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../.env -- prisma studio"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1"
  }
}
