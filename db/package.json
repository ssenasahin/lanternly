{
  "name": "@lanternly/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../.env -- prisma studio",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.0",
    "cron-parser": "^5.10.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1",
    "undici": "^8.12.3"
  }
}
