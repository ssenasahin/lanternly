// The single source of truth for Lanternly's data. Models use camelCase in
// TypeScript and are mapped to snake_case tables and columns in PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPER_ADMIN
}

enum MonitorType {
  HTTP
  // A request of the owner's design, its answer checked against a status list and rules.
  API
  PING
  // Up when a TCP connection to host:port opens.
  TCP
  // Up when a DNS lookup answers, with the expected value if one is set.
  DNS
  // Checked the other way round: the job pings Lanternly, and silence is the alarm.
  HEARTBEAT
  // A server's agent reporting CPU, memory and disk. Silence or a full disk is the alarm.
  AGENT
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

enum BodyType {
  NONE
  JSON
  FORM
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
}

enum AssertionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  GREATER_THAN
  LESS_THAN
  EXISTS
  NOT_EXISTS
}

enum PingKind {
  SUCCESS
  START
  FAIL
}

// PENDING until the first check finishes, so a new monitor never shows as down.
enum MonitorStatus {
  PENDING
  UP
  DOWN
  DEGRADED
  PAUSED
}

enum CheckStatus {
  UP
  DOWN
  DEGRADED
}

enum TeamRole {
  OWNER
  MEMBER
}

// What happened to an incident, in order, for its timeline.
enum IncidentEventType {
  OPENED
  NOTIFIED
  // A delivery that didn't arrive, with the reason.
  NOT_DELIVERED
  ESCALATED
  ACKNOWLEDGED
  RESOLVED
}

// Email isn't a channel: alerts are emailed to the account's owner and to team
// members who accepted an invite, never to an address someone merely typed in.
enum ChannelType {
  SLACK
  TELEGRAM
  WEBHOOK
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(USER)
  // Encrypted at rest; null until two-factor sign-in is set up.
  totpSecret    String?   @map("totp_secret")
  // Set once the user proves they can produce a code; until then the secret is pending.
  totpEnabledAt DateTime? @map("totp_enabled_at")
  // The time step of the last accepted code; older or equal steps are refused as replays.
  totpLastStep  Int?      @map("totp_last_step")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  monitors    Monitor[]
  channels    NotificationChannel[]
  ownedTeam   Team?
  apiKeys     ApiKey[]
  memberships TeamMember[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  backupCodes BackupCode[]

  @@map("users")
}

// A key for the public REST API. Only its hash is kept; the key is shown once.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  // The key's first characters, so the owner can tell keys apart.
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  // Revoked keys stay listed, so it's clear what stopped working and when.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("api_keys")
}

// One row per signed-in device. The refresh token itself is never stored, only its hash.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  // True once the second factor was checked for this session.
  mfa              Boolean   @default(false)
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Ten single-use codes for when the authenticator app is lost.
model BackupCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

model Monitor {
  id            String        @id @default(uuid()) @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  name          String
  type          MonitorType
  target        String
  intervalSec   Int           @default(60) @map("interval_sec")
  timeoutMs     Int           @default(10000) @map("timeout_ms")
  retries       Int           @default(1)
  // Answers slower than this count as degraded. Null: any answer in time is up.
  slowAfterMs   Int?          @map("slow_after_ms")
  isActive      Boolean       @default(true) @map("is_active")
  status        MonitorStatus @default(PENDING)
  lastCheckedAt DateTime?     @map("last_checked_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  checks             CheckResult[]
  rollups            CheckRollup[]
  incidents          Incident[]
  heartbeat          Heartbeat?
  apiRequest         ApiRequest?
  assertions         Assertion[]
  dnsQuery           DnsQuery?
  agent              Agent?
  // Who hears about an outage, and who next if nobody acknowledges it. Null: the
  // owner by email and every enabled channel, all at once.
  escalationPolicyId String?           @map("escalation_policy_id") @db.Uuid
  escalationPolicy   EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("monitors")
}

model CheckResult {
  id         BigInt      @id @default(autoincrement())
  monitorId  String      @map("monitor_id") @db.Uuid
  status     CheckStatus
  responseMs Int?        @map("response_ms")
  statusCode Int?        @map("status_code")
  error      String?
  // Every rule's verdict ({ path, operator, expected, received, passed }), kept when
  // one failed, so the failure can be shown as expected against received.
  rules      Json?
  checkedAt  DateTime    @default(now()) @map("checked_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Every chart and uptime figure reads one monitor's results over a time range.
  @@index([monitorId, checkedAt])
  @@map("check_results")
}

// One row per monitor per hour, for results older than seven days. The nightly job
// writes these and deletes the raw rows they summarise, so check_results stays small
// while 30-day uptime and response times remain answerable.
model CheckRollup {
  monitorId     String   @map("monitor_id") @db.Uuid
  // The start of the hour, in UTC.
  hour          DateTime
  checks        Int
  // Checks that found the monitor down. Degraded counts as up: it answered.
  failures      Int
  // Over the checks that measured a response time (failed ones often can't).
  responseCount Int      @map("response_count")
  responseAvgMs Float?   @map("response_avg_ms")
  responseP95Ms Float?   @map("response_p95_ms")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([monitorId, hour])
  @@map("check_rollups")
}

// The schedule of a HEARTBEAT monitor. Its results, state and incidents live on the
// monitor like any other's; this row only says when the next ping is due.
model Heartbeat {
  monitorId   String    @id @map("monitor_id") @db.Uuid
  // The secret in the ping URL. Random, so URLs can't be guessed from one another.
  token       String    @unique
  // Either a fixed period or a cron expression, never both.
  periodSec   Int?      @map("period_sec")
  cron        String?
  // The cron expression is read in this zone, so "0 3 * * *" means 03:00 there.
  timezone    String    @default("UTC")
  // How late a ping may be before the job counts as down.
  graceSec    Int       @map("grace_sec")
  // The last success or failure ping; start pings don't count.
  lastPingAt  DateTime? @map("last_ping_at")
  // Set by a start ping and cleared by the ping that ends the run, to time it.
  lastStartAt DateTime? @map("last_start_at")

  monitor Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  pings   HeartbeatPing[]

  @@map("heartbeats")
}

// Every ping received, with enough of the request to tell runs apart when debugging.
model HeartbeatPing {
  id         BigInt   @id @default(autoincrement())
  monitorId  String   @map("monitor_id") @db.Uuid
  kind       PingKind
  receivedAt DateTime @default(now()) @map("received_at")
  // How long the run took, when a start ping came first.
  durationMs Int?     @map("duration_ms")
  ip         String?
  userAgent  String?  @map("user_agent")
  // The first 10 KB of the request body: often the job's output or error.
  body       String?

  heartbeat Heartbeat @relation(fields: [monitorId], references: [monitorId], onDelete: Cascade)

  @@index([monitorId, receivedAt])
  @@map("heartbeat_pings")
}

// How an API monitor calls its endpoint. The URL is the monitor's target.
model ApiRequest {
  monitorId      String     @id @map("monitor_id") @db.Uuid
  method         HttpMethod @default(GET)
  // AES-GCM ciphertext of the headers as JSON, [{ name, value, secret }]: they often
  // carry API keys. Secret values are never sent back to the browser.
  headers        String?
  bodyType       BodyType   @default(NONE) @map("body_type")
  body           String?
  // Like "200-299" or "200, 304".
  expectedStatus String     @default("200-299") @map("expected_status")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("api_requests")
}

// One rule an API monitor's JSON answer must pass, like data.items[0].price > 0.
model Assertion {
  id        String            @id @default(uuid()) @db.Uuid
  monitorId String            @map("monitor_id") @db.Uuid
  // Rules are checked, and shown, in the order they were written.
  position  Int
  path      String
  operator  AssertionOperator
  // Unused by EXISTS and NOT_EXISTS.
  expected  String?           @map("expected_value")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, position])
  @@map("assertions")
}

// What a DNS monitor asks for. The name it asks about is the monitor's target.
model DnsQuery {
  monitorId  String        @id @map("monitor_id") @db.Uuid
  recordType DnsRecordType @default(A) @map("record_type")
  // A value that must be among the answers; null accepts any answer.
  expected   String?
  // A public DNS server's address to ask instead of the system's resolver.
  resolver   String?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("dns_queries")
}

// The agent behind an AGENT monitor. Its key is shown once; only the hash is kept.
model Agent {
  monitorId  String    @id @map("monitor_id") @db.Uuid
  keyHash    String    @unique @map("key_hash")
  // The key's first characters, so the owner can tell keys apart.
  keyPrefix  String    @map("key_prefix")
  hostname   String?
  platform   String?
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  monitor Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  metrics AgentMetric[]

  @@map("agents")
}

// One sample from an agent: percentages, 0 to 100.
model AgentMetric {
  id      BigInt   @id @default(autoincrement())
  agentId String   @map("agent_id") @db.Uuid
  at      DateTime
  cpu     Float
  memory  Float
  disk    Float

  agent Agent @relation(fields: [agentId], references: [monitorId], onDelete: Cascade)

  @@index([agentId, at])
  @@map("agent_metrics")
}

model Incident {
  id             String    @id @default(uuid()) @db.Uuid
  monitorId      String    @map("monitor_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at")
  // Null while the incident is still open.
  resolvedAt     DateTime? @map("resolved_at")
  cause          String?
  acknowledgedAt DateTime? @map("acknowledged_at")
  // Who acknowledged it, in words: "ada@example.com" or "via the link sent to #ops".
  acknowledgedBy String?   @map("acknowledged_by")
  // The last escalation step that has been notified; 0 is the first.
  escalationStep Int       @default(0) @map("escalation_step")

  monitor Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  events  IncidentEvent[]

  @@index([monitorId, resolvedAt])
  @@map("incidents")
}

model IncidentEvent {
  id         BigInt            @id @default(autoincrement())
  incidentId String            @map("incident_id") @db.Uuid
  type       IncidentEventType
  at         DateTime          @default(now())
  // What the timeline says about it: who was told, by what, and why it failed.
  detail     String?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at])
  @@map("incident_events")
}

// Every user has one team, made the first time they open it. Its members are the
// people escalation can reach.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @unique @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  owner    User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  invites  TeamInvite[]
  policies EscalationPolicy[]

  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// An emailed invitation. Only the token's hash is kept; accepting it needs an
// account with the invited address.
model TeamInvite {
  id         String    @id @default(uuid()) @db.Uuid
  teamId     String    @map("team_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_invites")
}

model EscalationPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  name      String
  // [{ waitMinutes, targets: [{ kind: "member", userId } | { kind: "channel", channelId }] }]
  // The first step's wait is 0: it's who hears first.
  steps     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitors Monitor[]

  @@index([teamId])
  @@map("escalation_policies")
}

model NotificationChannel {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  type       ChannelType
  name       String
  // AES-GCM ciphertext of the channel's JSON settings (webhook URLs, bot tokens).
  config     String
  // Disabled channels keep their settings but get no alerts.
  enabled    Boolean     @default(true)
  lastSentAt DateTime?   @map("last_sent_at")
  // Why the last delivery failed; null when it went through.
  lastError  String?     @map("last_error")
  createdAt  DateTime    @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("notification_channels")
}
