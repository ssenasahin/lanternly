// The single source of truth for Lanternly's data. Models use camelCase in
// TypeScript and are mapped to snake_case tables and columns in PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPER_ADMIN
}

enum MonitorType {
  HTTP
  // A request of the owner's design, its answer checked against a status list and rules.
  API
  PING
  // Checked the other way round: the job pings Lanternly, and silence is the alarm.
  HEARTBEAT
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

enum BodyType {
  NONE
  JSON
  FORM
}

enum AssertionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  GREATER_THAN
  LESS_THAN
  EXISTS
  NOT_EXISTS
}

enum PingKind {
  SUCCESS
  START
  FAIL
}

// PENDING until the first check finishes, so a new monitor never shows as down.
enum MonitorStatus {
  PENDING
  UP
  DOWN
  DEGRADED
  PAUSED
}

enum CheckStatus {
  UP
  DOWN
  DEGRADED
}

enum ChannelType {
  EMAIL
  SLACK
  TELEGRAM
  WEBHOOK
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(USER)
  // Encrypted at rest; null until two-factor sign-in is set up.
  totpSecret    String?   @map("totp_secret")
  // Set once the user proves they can produce a code; until then the secret is pending.
  totpEnabledAt DateTime? @map("totp_enabled_at")
  // The time step of the last accepted code; older or equal steps are refused as replays.
  totpLastStep  Int?      @map("totp_last_step")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  monitors    Monitor[]
  channels    NotificationChannel[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  backupCodes BackupCode[]

  @@map("users")
}

// One row per signed-in device. The refresh token itself is never stored, only its hash.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  // True once the second factor was checked for this session.
  mfa              Boolean   @default(false)
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Ten single-use codes for when the authenticator app is lost.
model BackupCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

model Monitor {
  id            String        @id @default(uuid()) @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  name          String
  type          MonitorType
  target        String
  intervalSec   Int           @default(60) @map("interval_sec")
  timeoutMs     Int           @default(10000) @map("timeout_ms")
  retries       Int           @default(1)
  // Answers slower than this count as degraded. Null: any answer in time is up.
  slowAfterMs   Int?          @map("slow_after_ms")
  isActive      Boolean       @default(true) @map("is_active")
  status        MonitorStatus @default(PENDING)
  lastCheckedAt DateTime?     @map("last_checked_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  checks     CheckResult[]
  rollups    CheckRollup[]
  incidents  Incident[]
  heartbeat  Heartbeat?
  apiRequest ApiRequest?
  assertions Assertion[]

  @@index([ownerId])
  @@map("monitors")
}

model CheckResult {
  id         BigInt      @id @default(autoincrement())
  monitorId  String      @map("monitor_id") @db.Uuid
  status     CheckStatus
  responseMs Int?        @map("response_ms")
  statusCode Int?        @map("status_code")
  error      String?
  // Every rule's verdict ({ path, operator, expected, received, passed }), kept when
  // one failed, so the failure can be shown as expected against received.
  rules      Json?
  checkedAt  DateTime    @default(now()) @map("checked_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Every chart and uptime figure reads one monitor's results over a time range.
  @@index([monitorId, checkedAt])
  @@map("check_results")
}

// One row per monitor per hour, for results older than seven days. The nightly job
// writes these and deletes the raw rows they summarise, so check_results stays small
// while 30-day uptime and response times remain answerable.
model CheckRollup {
  monitorId     String   @map("monitor_id") @db.Uuid
  // The start of the hour, in UTC.
  hour          DateTime
  checks        Int
  // Checks that found the monitor down. Degraded counts as up: it answered.
  failures      Int
  // Over the checks that measured a response time (failed ones often can't).
  responseCount Int      @map("response_count")
  responseAvgMs Float?   @map("response_avg_ms")
  responseP95Ms Float?   @map("response_p95_ms")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([monitorId, hour])
  @@map("check_rollups")
}

// The schedule of a HEARTBEAT monitor. Its results, state and incidents live on the
// monitor like any other's; this row only says when the next ping is due.
model Heartbeat {
  monitorId   String    @id @map("monitor_id") @db.Uuid
  // The secret in the ping URL. Random, so URLs can't be guessed from one another.
  token       String    @unique
  // Either a fixed period or a cron expression, never both.
  periodSec   Int?      @map("period_sec")
  cron        String?
  // The cron expression is read in this zone, so "0 3 * * *" means 03:00 there.
  timezone    String    @default("UTC")
  // How late a ping may be before the job counts as down.
  graceSec    Int       @map("grace_sec")
  // The last success or failure ping; start pings don't count.
  lastPingAt  DateTime? @map("last_ping_at")
  // Set by a start ping and cleared by the ping that ends the run, to time it.
  lastStartAt DateTime? @map("last_start_at")

  monitor Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  pings   HeartbeatPing[]

  @@map("heartbeats")
}

// Every ping received, with enough of the request to tell runs apart when debugging.
model HeartbeatPing {
  id         BigInt   @id @default(autoincrement())
  monitorId  String   @map("monitor_id") @db.Uuid
  kind       PingKind
  receivedAt DateTime @default(now()) @map("received_at")
  // How long the run took, when a start ping came first.
  durationMs Int?     @map("duration_ms")
  ip         String?
  userAgent  String?  @map("user_agent")
  // The first 10 KB of the request body: often the job's output or error.
  body       String?

  heartbeat Heartbeat @relation(fields: [monitorId], references: [monitorId], onDelete: Cascade)

  @@index([monitorId, receivedAt])
  @@map("heartbeat_pings")
}

// How an API monitor calls its endpoint. The URL is the monitor's target.
model ApiRequest {
  monitorId      String     @id @map("monitor_id") @db.Uuid
  method         HttpMethod @default(GET)
  // AES-GCM ciphertext of the headers as JSON, [{ name, value, secret }]: they often
  // carry API keys. Secret values are never sent back to the browser.
  headers        String?
  bodyType       BodyType   @default(NONE) @map("body_type")
  body           String?
  // Like "200-299" or "200, 304".
  expectedStatus String     @default("200-299") @map("expected_status")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("api_requests")
}

// One rule an API monitor's JSON answer must pass, like data.items[0].price > 0.
model Assertion {
  id        String            @id @default(uuid()) @db.Uuid
  monitorId String            @map("monitor_id") @db.Uuid
  // Rules are checked, and shown, in the order they were written.
  position  Int
  path      String
  operator  AssertionOperator
  // Unused by EXISTS and NOT_EXISTS.
  expected  String?           @map("expected_value")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, position])
  @@map("assertions")
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  monitorId  String    @map("monitor_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at")
  // Null while the incident is still open.
  resolvedAt DateTime? @map("resolved_at")
  cause      String?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, resolvedAt])
  @@map("incidents")
}

model NotificationChannel {
  id        String      @id @default(uuid()) @db.Uuid
  ownerId   String      @map("owner_id") @db.Uuid
  type      ChannelType
  name      String
  // AES-GCM ciphertext of the channel's JSON settings (webhook URLs, bot tokens).
  config    String
  createdAt DateTime    @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("notification_channels")
}
