{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The browser bundle is built by Vite, so TypeScript only type-checks it.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "sourceMap": false
  },
  "include": ["src", "vite.config.ts"]
}
