# Copy this file to .env and fill in real values. .env is never committed.

# --- Infrastructure (docker-compose.yml reads these too) ---
POSTGRES_USER=lanternly
POSTGRES_PASSWORD=lanternly
POSTGRES_DB=lanternly
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 (::1) first, where
# the containers don't listen, and every new connection waits two seconds to fall back.
DATABASE_URL=postgresql://lanternly:lanternly@127.0.0.1:5432/lanternly
REDIS_URL=redis://127.0.0.1:6379

# Password for demo@lanternly.dev, created by `npm run db:seed`. Pick your own.
SEED_DEMO_PASSWORD=change-me-before-seeding

# --- Email (Mailpit in development) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Lanternly <alerts@lanternly.local>"

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Where cron jobs reach the API: heartbeat ping URLs start with this. Defaults to
# http://localhost:API_PORT, which only works for jobs on this machine.
# PUBLIC_API_URL=https://api.example.com

# Signs access tokens; anyone who has it can sign in as any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Encrypts TOTP secrets, channel tokens and API monitor headers in the database; the
# worker reads it too. Losing it makes them unreadable: changing it locks everyone
# with two-factor out of the second step, leaving only their backup codes, and API
# monitors lose their headers. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Reverse proxies in front of the API (0 locally, usually 1 behind a load balancer).
TRUST_PROXY=0
AUTH_RATE_LIMIT_PER_MINUTE=10

# Tests run against their own database so they never touch your data.
DATABASE_URL_TEST=postgresql://lanternly:lanternly@127.0.0.1:5432/lanternly_test
