    "test": "vitest run"
  },
  "dependencies": {
    "@lanternly/db": "^0.1.0",
    "bullmq": "^6.5.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
